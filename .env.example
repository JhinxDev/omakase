# Copy to .env when running the CLI or self-hosted counter, then fill in real values.

# Optional for CLI / MCP usage: an API key for one of the supported cloud LLM backends.
# Common picks (free tiers):
#   Gemini Flash  -> https://aistudio.google.com/apikey
#   OpenRouter    -> https://openrouter.ai/keys
OMAKASE_API_KEY=

# Optional in hosted BYOK mode: comma-separated HTTPS origins whose OpenWebUI
# instances visitors may select, for example https://models.example.com.
OMAKASE_OPENWEBUI_ALLOWED_ORIGINS=

# Optional for CLI mode: MyAnimeList Client ID (only if fetching live MAL lists instead of XML exports).
# Get one at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
